# FinFlow Environment Configuration Template
# Copy this file to .env (root) or .env.local (frontend) as appropriate.

# ==============================================================================
# Backend Configuration
# ==============================================================================
PORT=8000
ENVIRONMENT=development
# Allowed CORS origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (SQLite default; set DATABASE_URL for PostgreSQL/Supabase)
DATABASE_PATH=finflow.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/finflow

# Development Offline JWT Secret (used ONLY in non-production when ENVIRONMENT != "production")
DEV_JWT_SECRET=finflow-dev-secret-not-for-production-use-2026

# Supabase Auth Configuration (Required in production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-production-supabase-jwt-secret
# NOTE: SUPABASE_SERVICE_ROLE_KEY is backend-only and must NEVER be exposed to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-backend-only-service-role-key

# Rate Limiting & Security
RATE_LIMIT_ENABLED=true

# ML Model Paths
MODEL_PATH=transaction_type_classifier.joblib
DATASET_PATH=personal_finance_dummy_dataset_1200.csv

# Sentry Monitoring (Optional)
SENTRY_DSN=

# ==============================================================================
# Frontend Configuration (Vite requires VITE_ prefix)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SENTRY_DSN=

# Site Configuration & Metadata (Optional)
VITE_OWNER_NAME=FinFlow
VITE_CONTACT_EMAIL=support@finflow.app
VITE_GITHUB_URL=https://github.com/Itzjay169/Finflow
VITE_LINKEDIN_URL=
VITE_X_URL=
VITE_PORTFOLIO_URL=
VITE_REPO_URL=https://github.com/Itzjay169/Finflow
VITE_CHANGELOG_URL=
