# FinFlow Environment Configuration Template

# Backend Environment Variables
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://finflow.vercel.app

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ML Model Path
MODEL_PATH=transaction_type_classifier.joblib
DATASET_PATH=personal_finance_dummy_dataset_1200.csv

# Sentry Monitoring (Optional)
SENTRY_DSN=

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:8000
VITE_SENTRY_DSN=

# Site Configuration & Footer Links (leave empty to omit links)
VITE_OWNER_NAME=FinFlow
VITE_CONTACT_EMAIL=
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_X_URL=
VITE_PORTFOLIO_URL=
VITE_REPO_URL=
VITE_CHANGELOG_URL=

