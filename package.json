{
  "name": "finflow",
  "version": "1.0.0",
  "description": "FinFlow – Personal Finance Tracker with ML Prediction & Interactive Telemetry",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "backend\\venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "backend\\venv\\Scripts\\pytest.exe"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
